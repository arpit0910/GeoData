APP_NAME=SetuGeo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://setugeo.com

# Official NSE/BSE equity calendar sources (override only if an exchange moves its page).
NSE_HOLIDAY_URL=https://www.nseindia.com/api/holiday-master?type=trading
BSE_HOLIDAY_URL=https://www.bseindia.com/static/markets/marketinfo/listholi.aspx/1000
BSE_HOLIDAY_URL_2025=https://www.bseindia.com/markets/MarketInfo/DispNewNoticesCirculars.aspx?page=20241213-30
BSE_HOLIDAY_URL_2026=https://www.bseindia.com/markets/MarketInfo/DispNewNoticesCirculars.aspx?page=20251212-8
BSE_HOLIDAY_UPDATE_URL_2026=https://www.bseindia.com/markets/MarketInfo/DispNewNoticesCirculars.aspx?page=20260112-8
EXCHANGE_CALENDAR_VERIFY_TLS=true
# Leave blank to use the operating system CA trust store.
EXCHANGE_CALENDAR_CA_BUNDLE=

# Upstox read-only market quote access. Refresh this token each trading day.
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_NOTIFIER_SECRET=
UPSTOX_TOKEN_LIFETIME_YEARS=10
UPSTOX_TOKEN_REQUEST_URL=https://api.upstox.com/v3/login/auth/token/request
UPSTOX_QUOTE_URL=https://api.upstox.com/v3/market-quote/quotes
UPSTOX_LTP_URL=https://api.upstox.com/v3/market-quote/ltp
UPSTOX_FUNDAMENTALS_URL=https://api.upstox.com/v2/fundamentals
UPSTOX_CORPORATE_ACTIONS_URL=https://api.upstox.com/v2/fundamentals
UPSTOX_NEWS_URL=https://api.upstox.com/v2/news
UPSTOX_NEWS_MAX_BATCHES=20
UPSTOX_GLOBAL_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/global.json.gz

# NVIDIA NIM powers news generation through its OpenAI-compatible API.
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NEWS_MODEL=openai/gpt-oss-120b
NVIDIA_NEWS_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3-next-80b-a3b-instruct,deepseek-ai/deepseek-v4-flash
NVIDIA_NEWS_VERIFICATION_MODELS=openai/gpt-oss-20b
NVIDIA_NEWS_STRICT_JSON_MODELS=
NVIDIA_NEWS_MODEL_STRATEGY=round_robin
NVIDIA_NEWS_TEMPERATURE=0.1
NVIDIA_NEWS_EDITORIAL_ATTEMPTS=1
NVIDIA_API_TIMEOUT=90
NVIDIA_RETRY_ATTEMPTS=4
NVIDIA_RETRY_INITIAL_DELAY_MS=1000
NVIDIA_RETRY_MAX_DELAY_MS=8000
NVIDIA_RETRY_JITTER_MS=250
NVIDIA_RATE_LIMIT_RETRY_SECONDS=300
NVIDIA_NEWS_REWRITE_MAX_TOKENS=1400
NVIDIA_NEWS_VERIFICATION_MAX_TOKENS=256
NVIDIA_NEWS_QWEN_MAX_TOKENS=1200
# Leave blank to use the operating system CA trust store.
NVIDIA_CA_BUNDLE=

# OCR Microservice (SetuGeoOCR)
OCR_SERVICE_URL=http://localhost:8001
OCR_SERVICE_API_KEY=your-secret-api-key-change-this
OCR_SERVICE_TIMEOUT=30
OCR_SERVICE_CONNECT_TIMEOUT=5

# Optional. Leave blank to derive the overview payload locally.
FINANCIAL_API_OVERVIEW_ENDPOINT=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=setugeo
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUBSCRIPTION_PURCHASES_ENABLED=false
# Temporarily activates selected plans without collecting payment. Disable when a gateway is live.
SUBSCRIPTION_TEMPORARY_CHECKOUT_ENABLED=true

# Leave blank to use the operating system CA trust store.
MARKET_DATA_CA_BUNDLE=
AMFI_CA_BUNDLE=
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
UPSTOX_MF_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/mf-instruments.json.gz
